<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_caea" model="ir.ui.view">
        <field name="name">account.journal.form.caea</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="l10n_ar.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="l10n_ar_afip_pos_number" position="after">
                <field name="l10n_ar_afip_pos_caea"
                       invisible="country_code != 'AR' or type != 'sale'"/>
                <field name="l10n_ar_caea_journal_id"
                       invisible="country_code != 'AR' or type != 'sale' or l10n_ar_afip_pos_caea"/>
            </field>
        </field>
    </record>
</odoo>
