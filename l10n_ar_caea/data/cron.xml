<odoo>
    <!-- Cron 1: solicita CAEA de la próxima quincena (días 11-15 ó
         27-fin del mes). Diario 09:00 — sólo corre si la company tiene
         l10n_ar_caea_enabled=True. -->
    <record id="cron_caea_request" model="ir.cron">
        <field name="name">CAEA — Solicitud automática</field>
        <field name="model_id" ref="model_l10n_ar_caea"/>
        <field name="state">code</field>
        <field name="code">model._cron_request_caea()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Cron 2: marca como expired los CAEA cuya quincena ya cerró.
         Diario 00:30. -->
    <record id="cron_caea_check_expiry" model="ir.cron">
        <field name="name">CAEA — Marcar vencidos</field>
        <field name="model_id" ref="model_l10n_ar_caea"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Cron 3: rinde a AFIP los CAEA cerrados (con o sin movimientos).
         Diario 03:00 — sólo corre si la company tiene
         l10n_ar_caea_enabled=True. -->
    <record id="cron_caea_rendir" model="ir.cron">
        <field name="name">CAEA — Rendición informativa + sin movimiento</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_caea_rendir()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
