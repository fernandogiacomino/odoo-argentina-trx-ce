<odoo>
    <record id="view_subdiario_iva_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ar.subdiario.iva.wizard.form</field>
        <field name="model">l10n_ar.subdiario.iva.wizard</field>
        <field name="arch" type="xml">
            <form string="Subdiario IVA Compras / Ventas">
                <sheet>
                    <group invisible="state == 'done'">
                        <group>
                            <field name="company_id" options="{'no_open': True}"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="include_sales"/>
                            <field name="include_purchases"/>
                        </group>
                    </group>
                    <group invisible="state != 'done'" string="Archivo XLSX generado">
                        <field name="file_name" readonly="1"/>
                        <field name="file_content"
                               filename="file_name"
                               readonly="1"
                               widget="binary"/>
                    </group>
                    <field name="state" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_open_interactive_view"
                            type="object"
                            string="Ver en pantalla"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <button name="action_print_pdf"
                            type="object"
                            string="Generar PDF"
                            class="btn-secondary"
                            invisible="state == 'done'"/>
                    <button name="action_export_xlsx"
                            type="object"
                            string="Exportar XLSX"
                            class="btn-secondary"
                            invisible="state == 'done'"/>
                    <button string="Cerrar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_subdiario_iva_wizard" model="ir.actions.act_window">
        <field name="name">Subdiario IVA</field>
        <field name="res_model">l10n_ar.subdiario.iva.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Bajo el menú "Argentina" creado por libro_iva_digital_wizard_view.xml -->
    <menuitem id="menu_subdiario_iva"
              name="Subdiario IVA Compras/Ventas"
              parent="menu_l10n_ar_root"
              action="action_subdiario_iva_wizard"
              sequence="20"/>
</odoo>
